# SQLite database file (relative to this folder). Defaults to file:./prisma/dev.db when unset.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session cookies. Required in production; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Where uploaded verification documents are stored. Defaults to ./uploads.
# UPLOAD_DIR="./uploads"

# Show the demo-account list on /login in a production build (it is always shown in development).
# SHOW_DEMO_ACCOUNTS="true"
