# ─── Readyhire configuration ────────────────────────────────────────────────
# Copy to .env for local development. In production set these in your host's
# dashboard (Vercel → Project → Settings → Environment Variables).
# The app validates everything at startup and lists any problems (src/lib/env.ts).

# development | test | staging | production. Defaults to production on Vercel
# production deployments, staging on Vercel previews, development locally.
# staging/production require S3 storage, a real email provider, CRON_SECRET and https.
# APP_ENV="development"

# Public URL of the app (used in email links and security headers).
APP_URL="http://localhost:3000"

# ─── Database (PostgreSQL 15+) ──────────────────────────────────────────────
# Local: `docker compose up -d` provides this database.
DATABASE_URL="postgresql://readyhire:readyhire@localhost:5432/readyhire"
# Direct (non-pooled) connection for migrations. Needed when DATABASE_URL points at a pooler
# (e.g. Supabase transaction pooler on port 6543). Leave unset locally.
# DIRECT_URL=""
# Connections per app instance (keep small on serverless).
# DATABASE_POOL_SIZE="5"

# ─── Sessions ───────────────────────────────────────────────────────────────
# At least 32 random characters in staging/production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
AUTH_SECRET="replace-with-a-long-random-string"

# ─── Document storage ───────────────────────────────────────────────────────
# local (development/tests only) or s3 (any S3-compatible service).
STORAGE_DRIVER="local"
# LOCAL_STORAGE_DIR="./storage"
# S3_BUCKET="readyhire-documents"
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Only for non-AWS providers (Cloudflare R2, Supabase Storage, MinIO, LocalStack):
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="false"

# ─── Email ──────────────────────────────────────────────────────────────────
# console (prints emails to the terminal), resend or smtp.
EMAIL_DRIVER="console"
EMAIL_FROM="Readyhire <no-reply@readyhire.local>"
# RESEND_API_KEY=""
# SMTP_URL="smtps://user:password@smtp.example.com:465"

# ─── Scheduled jobs ─────────────────────────────────────────────────────────
# Bearer token for /api/cron/reminders (Vercel Cron sends it automatically when set).
# CRON_SECRET=""

# Show the demo-account list on /login outside development (never in real production).
# SHOW_DEMO_ACCOUNTS="false"
